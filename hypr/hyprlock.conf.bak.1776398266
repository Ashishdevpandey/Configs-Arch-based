source = ~/.config/omarchy/current/theme/hyprlock.conf

general {
    ignore_empty_input = true
}

background {
    monitor =
    color = $color
    path = /home/ashish/Pictures/Archive/Women/Lock.jpg
    blur_passes = 0
}

animations {
    enabled = false
}

# Digital Italic Clock
label {
    monitor =
    text = cmd[update:1000] echo "$TIME"
    color = $font_color
    font_size = 120
    font_family = JetBrainsMono Nerd Font ExtraBold Italic
    position = 700, -300
    halign = center
    valign = top
}

# Date
label {
    monitor =
    text = cmd[update:43200000] echo "$(date +"%^b-%d")"
    color = $font_color
    font_size = 80
    font_family = JetBrainsMono Nerd Font ExtraBold Italic
    position = -700, -300
    halign = center
    valign = top
}

# Day
label {
    monitor =
    text = cmd[update:43200000] echo "$(date +"%A")"
    color = $font_color
    font_size = 50
    font_family = JetBrainsMono Nerd Font ExtraBold Italic
    position = -700, -420
    halign = center
    valign = top
}


input-field {
    monitor =
    size = 650, 100
    position = 0, -350
    halign = center
    valign = center

    inner_color = $inner_color
    outer_color = $outer_color
    outline_thickness = 4

    font_family = JetBrainsMono Nerd Font
    font_color = $font_color

    placeholder_text = Enter Password
    check_color = $check_color
    fail_text = <i>Flaw My Darling ($ATTEMPTS)</i>

    rounding = 0
    shadow_passes = 0
    fade_on_empty = false
}

auth {
    fingerprint:enabled = false
}
